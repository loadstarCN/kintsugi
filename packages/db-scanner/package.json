      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
