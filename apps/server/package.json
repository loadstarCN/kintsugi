{
  "name": "@kintsugi/server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- node --watch -r @swc-node/register src/main.ts",
    "dev:once": "dotenv -e ../../.env -- node -r @swc-node/register src/main.ts",
    "bootstrap:demo": "dotenv -e ../../.env -- node -r @swc-node/register scripts/bootstrap-demo.ts",
    "test:introspect": "dotenv -e ../../.env -- node -r @swc-node/register scripts/test-introspect.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "dotenv -e ../../.env -- prisma generate",
    "prisma:push": "dotenv -e ../../.env -- prisma db push",
    "prisma:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "prisma:migrate:create": "dotenv -e ../../.env -- prisma migrate dev --create-only",
    "prisma:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "prisma:resolve-baseline": "dotenv -e ../../.env -- prisma migrate resolve --applied 20260503000000_initial_baseline",
    "prisma:studio": "dotenv -e ../../.env -- prisma studio",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "dbagent:eval": "dotenv -e ../../.env -- node -r @swc-node/register scripts/dbagent-eval.ts",
    "llm:eval": "node -r @swc-node/register scripts/llm-eval.ts",
    "spec:check": "node -r @swc-node/register scripts/check-platform-spec.ts",
    "spec:dump": "node -r @swc-node/register scripts/dump-platform-spec.ts",
    "mail:bootstrap": "dotenv -e ../../.env -- node -r @swc-node/register scripts/mail-bootstrap.ts",
    "bcrypt:cleanup": "dotenv -e ../../.env -- node -r @swc-node/register scripts/cleanup-bcrypt-access-keys.ts"
  },
  "dependencies": {
    "@kintsugi/db-scanner": "workspace:*",
    "@kintsugi/llm": "workspace:*",
    "@kintsugi/shared": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@prisma/client": "^5.20.0",
    "@types/body-parser": "^1.19.6",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "optionalDependencies": {
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.7.28",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.0",
    "@nestjs/testing": "^10.4.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.2",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.2"
  }
}
