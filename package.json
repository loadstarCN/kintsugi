{
  "name": "kintsugi-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "dev:server": "pnpm --filter @kintsugi/server dev",
    "dev:web": "pnpm --filter @kintsugi/web dev",
    "dev:docs": "pnpm --filter @kintsugi/docs dev",
    "build:docs": "pnpm --filter @kintsugi/docs build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "prisma:generate": "pnpm --filter @kintsugi/server prisma:generate",
    "prisma:migrate": "pnpm --filter @kintsugi/server prisma:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.1.1": "^2.1.1",
      "lodash@<4.18.0": "^4.18.0"
    }
  }
}
