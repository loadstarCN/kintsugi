# ============================================================
# Kintsugi（锦缮）— 环境变量模板
# 复制为 .env，填入真实值。切勿提交 .env。
# ============================================================

# ---- 平台元数据库（远端 PostgreSQL，托管 PostgreSQL）----
# 把下面替换为你的托管 PostgreSQL 连接串。建议使用专有网络/VPC 内网地址，生产强制 sslmode=require。
# 本地开发不在这台机器上装 PG；元数据 schema 通过 Prisma migrate 推到 RDS。
#
# ⚠️ 密码中若含 @ : / ? # % 等字符，必须 URL 编码：
#    @ → %40   : → %3A   / → %2F   ? → %3F   # → %23   % → %25
#    （多符号同时出现时，% 必须先编码）
# 例：密码 Abc@123! → 连接串里写 Abc%40123!
# 一键转换：在 Node REPL 里跑 encodeURIComponent('你的密码')
METADATA_DATABASE_URL="postgresql://USER:URL_ENCODED_PASSWORD@your-pg-host.example.com:5432/kintsugi?schema=public&sslmode=require"

# ---- 服务端口 ----
SERVER_PORT=4000
WEB_PORT=5173

# ---- Session / Auth ----
SESSION_SECRET="change-me-to-a-random-32+ char string"
# 生产强制 ≥32 字节，启动时 fail-fast。生成：openssl rand -hex 48
JWT_SECRET="change-me-too-this-must-be-at-least-32-bytes-in-production"
# AES-256-GCM 加密 key（webhook secret / accessKey secret / datasource password）。
# 生产强制 32 字节 hex；丢失 = 全部加密数据无法解密
ENCRYPTION_KEY=

# Express trust proxy 设置；线上有 nginx/SLB 时设为反代层数（如 1）或 IP 列表
TRUST_PROXY=

# ---- LLM provider ----
# 可插拔：deepseek | openai | anthropic | qwen | azure-openai 等（待实现）
# 默认 DeepSeek（OpenAI 兼容接口）。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# provider 默认超时（单次 HTTP 请求上限），被 LLM_PER_CALL_TIMEOUT_MS 覆盖
LLM_TIMEOUT_MS=300000

# DBAgent 把 schema 分批喂给 LLM 的参数：
#   CHUNK_SIZE: 每批多少张表
#   PER_CALL_TIMEOUT_MS: 单次 LLM 调用的硬超时（毫秒）
#   PER_CALL_RETRIES: 单批首次失败后重试次数
LLM_CHUNK_SIZE=6
LLM_PER_CALL_TIMEOUT_MS=90000
LLM_PER_CALL_RETRIES=1

# ---- Redis（速率限制 / 缓存 / 队列），MVP 可留空 ----
REDIS_URL=

# ---- LLM provider failover（可选，掉单时自动切到备 provider）----
# LLM_FALLBACK_PROVIDER=openai
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# LLM_FALLBACK_TIMEOUT_MS=60000

# ---- 试用账户 ----
# 默认：申请审批通过后建 TRIAL 租户，14 天到期 → 拒登录
TRIAL_DAYS=14
# 试用 quota：1 个数据源 / 3 个数据集 / 50 次/天 LLM 调用 / 5 元 aiCredits
TRIAL_MAX_DATASOURCES=1
TRIAL_MAX_DATASETS=3
TRIAL_MAX_DAILY_LLM_CALLS=50
TRIAL_AI_CREDIT_INIT=5

# 公开 register 默认关（商业系统走 /api/trial/apply）。
# 本地开发想用 /api/auth/register 时打开：
# KINTSUGI_ALLOW_PUBLIC_REGISTER=true

# /api/trial/apply 公开端点 IP 节流（默认 3/min）
TRIAL_APPLY_RATE_PER_MIN=3

# Access key rotate grace 期：默认 60 min，上限 240 min。
# 旧版本上限 1440 (24h) 太宽松，被偷的旧 secret 一天才失效。
ACCESS_KEY_ROTATE_GRACE_DEFAULT_MIN=60
ACCESS_KEY_ROTATE_GRACE_MAX_MIN=240

# ---- AI 计费 ----
# 价格 = (tokens / 1000) × price_per_1k
AI_CREDIT_PRICE_PROMPT_PER_1K=0.001
AI_CREDIT_PRICE_COMPLETION_PER_1K=0.004
# 每次 LLM 调用预扣的金额（reserve-then-settle 模式防 TOCTOU 超支）。
# 设 0 = 关闭预扣（不推荐，会让两个并发请求都过余额检查）
AI_CREDIT_RESERVE_PER_CALL=0.10
# 余额下限：低于这个数 + reserve → 拒新调用
AI_CREDIT_MIN_BALANCE=0
# 滚动 1h 窗口告警阈值（元）；0/未设 = 关闭。超阈值 emit warn-log + counter
LLM_BUDGET_YUAN_PER_HOUR=0
# 同一租户同一小时 warn 上限（去抖防日志风暴）
LLM_BUDGET_THROTTLE_AFTER_BREACHES=3

# ---- 调度后台 tick ----
# 慢 tick：access key 过期扫 / 不活跃用户 / audit retention sweep
SCHEDULER_TICK_MS=21600000
# 快 tick：webhook 失败重试
WEBHOOK_RETRY_TICK_MS=30000
# 审计日志保留天数。0/未设 = 关闭 retention sweep（合规要求"绝不删"用此）
AUDIT_RETENTION_DAYS=365

# ---- 资源导入 ----
# bundle.zip 大小硬上限（防 zip bomb），默认 4MB
ASSET_IMPORT_MAX_BYTES=4194304

# ---- Mailpilot（邮件投递） ----
# 任一空 → mail.service 走 dry-run（log only，不真发）；本地 dev 默认即用
# MAILPILOT_BASE_URL=https://mailpilot.example.com
# MAILPILOT_API_KEY=
# 可选：mailpilot 项目里的 SMTP 配置 UUID；不传走项目默认 SMTP
# MAILPILOT_SMTP_CONFIG=
# 邮件里展示的客服 / 联系邮箱
KINTSUGI_SUPPORT_EMAIL=support@kintsugi.example.com
# 试用通知里跳转用的 login URL（生产填外网可访问地址）
KINTSUGI_LOGIN_URL=https://kintsugi.example.com/login
# 试用即将过期：到期前 N 天发提醒（默认 3）
TRIAL_EXPIRING_NOTICE_DAYS=3
# 付费订阅即将过期：到期前 N 天发提醒（默认 7）
SUBSCRIPTION_EXPIRING_NOTICE_DAYS=7
# 升级邮件里跳转用的 billing URL（生产填外网可访问地址）
KINTSUGI_BILLING_URL=https://kintsugi.example.com/billing

# ---- IM bridges 验签 ----
# 三家都在生产强制要 token；非生产未设默认拒，需显式 KINTSUGI_BRIDGE_DEV_BYPASS=true 才放行
FEISHU_VERIFY_TOKEN=
DINGTALK_VERIFY_SECRET=
WECOM_VERIFY_TOKEN=
# KINTSUGI_BRIDGE_DEV_BYPASS=true   # 仅 dev 用，跳过 token 校验

# ---- SSRF 防护 ----
# 设 true 让 webhook outbound + datasource 允许私网 host（仅本地开发）
# KINTSUGI_ALLOW_PRIVATE_HOSTS=true

# ---- DBAgent eval CI gate ----
# F1 阈值，低于 fail
DBAGENT_EVAL_MIN_F1=0.70

# ---- 调试脚本（apps/server/scripts/*.mjs）凭据，不要写硬编码 ----
# DEBUG_PG_HOST=
# DEBUG_PG_PORT=5432
# DEBUG_PG_USER=
# DEBUG_PG_PASSWORD=
# 或一并：DEBUG_DATABASE_URL=postgresql://...

# ---- 观测 ----
LOG_LEVEL=debug
# OTel 上报（生产开）
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=kintsugi-server
